# Copy to .deploy.env (gitignored) for `npm run deploy:prod`.
# SSH key auth only — never put passwords here.

DEPLOY_HOST=root@103.117.180.71
# Private key authorised on the server; leave empty to use your default key.
DEPLOY_KEY=$HOME/.ssh/voter-deploy
DEPLOY_PATH=/opt/booth-helpdesk

API_HEALTH_URL=https://voters.nabeenmultimedia.com/backend/health
WEB_HEALTH_URL=https://voters.nabeenmultimedia.com/login
BACKUP_DIR=/root/booth-backups
KEEP_BACKUPS=3

# Booth Help Desk shares the server with the IRA Media environment; these keep
# its deploys on its own folder, ports, services and domain.
DOMAIN=voters.nabeenmultimedia.com
API_PORT=4001
WEB_PORT=3001
API_SERVICE=booth-api
WEB_SERVICE=booth-web
UPLOAD_DOWNLOADS=false

# Optional: admin login for `npm run panchayat:import` (else it asks).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
