# Postgres connection string used by the API and the Prisma CLI
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voter_management?schema=public"

# Secret used to sign session and admin JWTs (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-string"

# How long a signed-in session lasts
JWT_EXPIRES_IN="30d"

PORT=4000
HOST=0.0.0.0

# Super admin created by `npm run db:seed` — change the password after first login
SUPERADMIN_EMAIL="admin@voter.local"
SUPERADMIN_PASSWORD="Admin@12345"
SUPERADMIN_NAME="Super Admin"

# Ed25519 private key (base64 DER) that signs desktop licence leases. Generate once:
#   node -e "const k=require(\"crypto\").generateKeyPairSync(\"ed25519\");console.log(k.privateKey.export({format:\"der\",type:\"pkcs8\"}).toString(\"base64\"))"
# The matching public key is built into apps/desktop/src/license.mjs.
LICENSE_SIGNING_KEY=

# Mobile app sign-in OTP via the MSG91 OTP widget (https://control.msg91.com). The
# app sends and checks the code with the widget; this key lets the API confirm the
# widget's access token. Leave empty to skip the OTP step. The app needs the
# widget id and token (EXPO_PUBLIC_MSG91_WIDGET_ID / EXPO_PUBLIC_MSG91_TOKEN_AUTH).
MSG91_AUTH_KEY=
