# API base URL. Use your machine's LAN IP (not localhost) when running on a device.
EXPO_PUBLIC_API_URL=http://localhost:4000

# MSG91 OTP widget for sign-in (MSG91 → OTP → Widget). Both are client-side values;
# the secret auth key stays on the API (MSG91_AUTH_KEY).
EXPO_PUBLIC_MSG91_WIDGET_ID=366a6e6a3059373336313133
EXPO_PUBLIC_MSG91_TOKEN_AUTH=
