{
  "name": "voter-management",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @voter/mobile",
    "mobile:ios": "npm run ios --workspace @voter/mobile",
    "mobile:android": "npm run android --workspace @voter/mobile",
    "mobile:apk": "bash scripts/build-apk.sh",
    "mobile:update": "cd apps/mobile && EXPO_PUBLIC_API_URL=https://voters.nabeenmultimedia.com/backend EXPO_PUBLIC_MSG91_WIDGET_ID=366a6e6a3059373336313133 EXPO_PUBLIC_MSG91_TOKEN_AUTH=581545TRrxqlHo6acf554dP1 eas update --channel booth --platform android --clear-cache --environment production",
    "api": "npm run dev --workspace @voter/api",
    "web": "npm run dev --workspace @voter/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @voter/api",
    "db:migrate": "npm run db:migrate --workspace @voter/api",
    "db:seed": "npm exec --workspace @voter/api -- prisma db seed",
    "db:studio": "npm run db:studio --workspace @voter/api",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "domain:setup": "bash scripts/setup-domain.sh",
    "admin:create": "bash scripts/create-admin-remote.sh",
    "load:test": "node scripts/load-test.mjs",
    "load:report": "python3 scripts/load-report.py",
    "load:users": "node scripts/load-users.mjs",
    "load:users:report": "python3 scripts/load-users-report.py",
    "desktop": "npm run start -w @voter/desktop",
    "desktop:build": "npm run build -w @voter/desktop",
    "roll:convert": "npm run convert -w @voter/roll-converter --",
    "panchayat:import": "node scripts/import-panchayat.mjs",
    "roll:models": "node packages/roll-converter/scripts/fetch-models.mjs",
    "roll:test": "npm test -w @voter/roll-converter",
    "desktop:smoke": "electron apps/desktop/src/smoke.mjs",
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "deploy:ocr": "bash scripts/deploy-ocr.sh",
    "deploy:xlit": "bash scripts/deploy-xlit.sh"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=20"
  }
}
