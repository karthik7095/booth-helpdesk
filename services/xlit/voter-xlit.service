[Unit]
Description=Voter roll name transliteration service (AI4Bharat IndicXlit, CPU)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/voter-management/xlit
ExecStart=/opt/voter-management/xlit/venv/bin/python -W ignore server.py
Environment=XLIT_PORT=4600
Environment=XLIT_THREADS=1
Environment=OMP_NUM_THREADS=1
Restart=on-failure
RestartSec=10
# Loads at ~0.5 GB (one model for Telugu and Hindi, rescoring off). Keep it
# small and below everything else on this shared box, OCR included.
MemoryMax=1200M
MemorySwapMax=0
CPUQuota=100%
Nice=10
User=voter-xlit
Group=voter-xlit
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
